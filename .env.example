# cakesync credentials and runtime options.
#
# Copy this file to .env and fill it in. Only credentials and a few runtime
# options go here. What to sync, and where, lives in cakesync.yml (copy
# cakesync.example.yml).

# CardDAV, read for contact birthdays. Needed when birthdays.sync_enabled is
# true in cakesync.yml. cakesync never writes to the address book, so a
# read-only app password is enough if your provider offers one.
#   CARDDAV_URL       Server root URL. Default: https://carddav.fastmail.com/dav/
#   CARDDAV_USERNAME  Login, usually your email address.
#   CARDDAV_PASSWORD  An app password, not your main account password.
CARDDAV_URL=https://carddav.fastmail.com/dav/
CARDDAV_USERNAME=you@example.com
CARDDAV_PASSWORD=

# CalDAV, read for calendars. Needed when cakesync.yml has at least one
# calendar with sync_enabled: true. cakesync never writes to the calendars.
#   CALDAV_URL        Server root URL. Default: https://caldav.fastmail.com/dav/
#   CALDAV_USERNAME   Login, usually your email address.
#   CALDAV_PASSWORD   An app password, not your main account password.
# On Fastmail, an app password works for one service only. The CardDAV password
# above returns 401 here, so create a second one with calendar (CalDAV) access.
CALDAV_URL=https://caldav.fastmail.com/dav/
CALDAV_USERNAME=you@example.com
CALDAV_PASSWORD=

# Server URLs for other providers:
#   Provider    CARDDAV_URL                                 CALDAV_URL
#   iCloud      https://contacts.icloud.com/                https://caldav.icloud.com/
#   Nextcloud   https://cloud.example.com/remote.php/dav/   same as CARDDAV_URL
#   Radicale    https://radicale.example.com/               same as CARDDAV_URL
#   Baïkal      https://baikal.example.com/dav.php/         same as CARDDAV_URL
#   SOGo        https://sogo.example.com/SOGo/dav/          same as CARDDAV_URL

# Todoist API token. Required. Find it in Todoist under Settings, Integrations,
# Developer: https://app.todoist.com/app/settings/integrations/developer
TODOIST_API_TOKEN=

# Optional. Path to the YAML config. Default: cakesync.yml in the folder where
# cakesync runs. The --config option overrides it.
# CAKESYNC_CONFIG=cakesync.yml

# Optional. Logging. Logs go to the console and to a file that rotates.
#   LOG_LEVEL         DEBUG, INFO, WARNING or ERROR. Default: INFO. DEBUG also
#                     lists the multi-day events skipped by mode "none". The
#                     --log-level option overrides it.
#   LOG_FILE          Path of the log file. Default: logs/sync.log
#   LOG_MAX_BYTES     Size in bytes at which the file rotates. Default: 1048576
#                     (1 MiB).
#   LOG_BACKUP_COUNT  How many old log files to keep. Default: 5.
# LOG_LEVEL=INFO
# LOG_FILE=logs/sync.log
# LOG_MAX_BYTES=1048576
# LOG_BACKUP_COUNT=5
